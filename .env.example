# AfyaPass Environment Variables Example
# Duplicate this file to .env.local for local development.
# DO NOT COMMIT SECRETS OR REAL CREDENTIALS TO GIT.

# Next.js Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development

# Supabase Backend Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder

# Supabase Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Security & Encryption Secrets
# Used for encrypting sensitive session claims or signing tokens
SECURITY_ENCRYPTION_SECRET=change-this-to-a-secure-random-32-character-secret
